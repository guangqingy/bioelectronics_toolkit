{
  "schema_version": 1,
  "default_category": "examples",
  "categories": [
    {
      "id": "examples",
      "label": "Runnable Examples",
      "description": "Self-contained smoke pipelines that run entirely from bundled examples/ data.",
      "documentation": "docs/pipelines/example_pipeline_README.md",
      "scripts": [
        {
          "id": "example_summary",
          "name": "Bundled Example Summary",
          "desc": "Read the bundled ABF, electrochemistry CSV, and fluorescence TIFF examples, then write a compact CSV/JSON/PNG summary.",
          "script": "example_summary.py",
          "script_path": "pipelines/examples/example_summary.py",
          "integration_status": "bundled_example",
          "params": [
            {
              "key": "output_dir",
              "label": "Output directory",
              "type": "path",
              "desc": "Leave blank to write under .dataprocess_cache/exports/pipeline_examples.",
              "default": ".dataprocess_cache/exports/pipeline_examples"
            }
          ]
        }
      ]
    },
    {
      "id": "photocurrent",
      "label": "Photocurrent Analysis",
      "description": "Publication-oriented photocurrent plots generated from ABF batch outputs.",
      "documentation": "docs/pipelines/photocurrent_pipeline_README.md",
      "scripts": [
        {
          "id": "pc_line_chart",
          "name": "Intensity-Response Curve",
          "desc": "Plot photocurrent peak or integral vs. power density on linear and log x-axes. Each series maps to one summary CSV folder.",
          "script": "model_line_chart.py",
          "script_path": "2025_Subcutaneous/Photocurrent/model_line_chart.py",
          "integration_status": "local_project_required",
          "params": [
            {
              "key": "base_dir",
              "label": "Base directory",
              "type": "path",
              "desc": "Leave blank for the local Subcutaneous group_2_electrode defaults."
            },
            {
              "key": "output_dir",
              "label": "Output folder name",
              "type": "text",
              "desc": "Created under base_dir.",
              "default": "electrode_peaks"
            },
            {
              "key": "series",
              "label": "Series (one per line)",
              "type": "textarea",
              "desc": "Optional override: Label | subfolder_name. Blank uses the local Subcutaneous electrode panel.",
              "default": ""
            },
            {
              "key": "metrics",
              "label": "Metrics",
              "type": "checkboxes",
              "options": [
                "peak",
                "integral"
              ],
              "defaults": [
                "peak",
                "integral"
              ]
            },
            {
              "key": "x_lin_range",
              "label": "Linear x-ranges",
              "type": "text",
              "desc": "Semicolon-separated ranges.",
              "default": "0-1; 0-4"
            },
            {
              "key": "x_log_range",
              "label": "Log x-ranges",
              "type": "text",
              "desc": "Semicolon-separated ranges.",
              "default": "0.01-1; 0.01-4"
            }
          ]
        },
        {
          "id": "pc_peaks_overlay",
          "name": "Peak Overlay Traces",
          "desc": "Align photocurrent waveforms to first significant peak, then average by intensity. Requires segment CSV files from Batch Processor.",
          "script": "model_peaks_overlay.py",
          "script_path": "2025_Subcutaneous/Photocurrent/model_peaks_overlay.py",
          "integration_status": "local_project_required",
          "params": [
            {
              "key": "base_dir",
              "label": "Base directory",
              "type": "path",
              "desc": "Leave blank for the local Subcutaneous group_2_electrode defaults."
            },
            {
              "key": "output_dir",
              "label": "Output folder",
              "type": "text",
              "default": "overlay_two_panel"
            },
            {
              "key": "materials",
              "label": "Materials (one per line)",
              "type": "textarea",
              "desc": "Optional override: Display Name | subfolder_name. Blank uses the local Subcutaneous electrode panel.",
              "default": ""
            },
            {
              "key": "pre_ms",
              "label": "Pre-peak window (ms)",
              "type": "number",
              "default": "10"
            },
            {
              "key": "post_ms",
              "label": "Post-peak window (ms)",
              "type": "number",
              "default": "30"
            },
            {
              "key": "n_intensity",
              "label": "Intensity anchor count",
              "type": "number",
              "default": "10"
            },
            {
              "key": "prom_thresh",
              "label": "Peak prominence threshold",
              "type": "number",
              "default": "0.1"
            }
          ]
        },
        {
          "id": "pc_heatmap",
          "name": "Heatmap with Trace Overlay",
          "desc": "2D spatial heatmap (cells x power levels) with individual photocurrent traces overlaid per cell.",
          "script": "model_heatmap.py",
          "script_path": "2025_Subcutaneous/Photocurrent/model_heatmap.py",
          "integration_status": "local_project_required",
          "params": [
            {
              "key": "base_dir",
              "label": "Base directory",
              "type": "path",
              "desc": "Leave blank for the local Subcutaneous group_2_electrode defaults."
            },
            {
              "key": "output_dir",
              "label": "Output folder",
              "type": "text",
              "default": "electrode_heatmap_withpeaks"
            },
            {
              "key": "materials",
              "label": "Materials (label | subfolder, one per line)",
              "type": "textarea",
              "desc": "Optional override. Blank uses the local Subcutaneous electrode panel.",
              "default": ""
            },
            {
              "key": "pre_ms",
              "label": "Pre-peak window (ms)",
              "type": "number",
              "default": "10"
            },
            {
              "key": "post_ms",
              "label": "Post-peak window (ms)",
              "type": "number",
              "default": "30"
            }
          ]
        },
        {
          "id": "pc_decay",
          "name": "Decay Curve",
          "desc": "Generate intensity-vs-cycle decay curves using the same Subcutaneous workflow across projects.",
          "script": "model_decay_curve.py",
          "script_path": "2025_Subcutaneous/Photocurrent/model_decay_curve.py",
          "integration_status": "local_project_required",
          "params": [
            {
              "key": "base_dir",
              "label": "Base directory",
              "type": "path",
              "desc": "Leave blank for the local Subcutaneous group_8_decay defaults."
            },
            {
              "key": "output_dir",
              "label": "Output folder",
              "type": "text",
              "default": "decay_line_chart"
            },
            {
              "key": "materials",
              "label": "Materials (label | subfolder)",
              "type": "textarea",
              "desc": "Optional override. Blank uses the local Subcutaneous decay panel.",
              "default": ""
            },
            {
              "key": "file_str",
              "label": "Date subfolder (optional)",
              "type": "text",
              "desc": "Blank uses the built-in local project decay folder."
            },
            {
              "key": "seq_to_time_factor",
              "label": "Seq to time factor (s)",
              "type": "number",
              "default": "2"
            },
            {
              "key": "x_lim",
              "label": "X limits (cycles)",
              "type": "text",
              "default": "0,400"
            },
            {
              "key": "y_lim",
              "label": "Y limits (optional)",
              "type": "text",
              "default": "0,1.2"
            }
          ]
        },
        {
          "id": "pc_longterm",
          "name": "Long-term Stability Bar",
          "desc": "Track mean photocurrent over multiple recording dates. Bars show mean +/- SEM; dots show individual samples.",
          "script": "model_longterm_bar.py",
          "script_path": "2025_Subcutaneous/Photocurrent/model_longterm_bar.py",
          "integration_status": "local_project_required",
          "params": [
            {
              "key": "base_dir",
              "label": "Base directory",
              "type": "path",
              "desc": "Leave blank for the local Subcutaneous group_10_long_term defaults."
            },
            {
              "key": "output_dir",
              "label": "Output folder",
              "type": "text",
              "default": "longterm_bars"
            },
            {
              "key": "material",
              "label": "Material subfolder",
              "type": "text",
              "desc": "Optional single-material override. Blank exports all configured materials.",
              "default": ""
            },
            {
              "key": "dates",
              "label": "Dates (YYYYMMDD, one per line)",
              "type": "textarea",
              "desc": "Optional override. Blank uses the built-in local project date panel.",
              "default": ""
            }
          ]
        }
      ]
    },
    {
      "id": "emg",
      "label": "EMG Analysis",
      "description": "Post-processing and figure pipelines for EMG peak exports.",
      "documentation": "docs/pipelines/emg_pipeline_README.md",
      "scripts": [
        {
          "id": "emg_demo",
          "name": "Representative Waveform",
          "desc": "Display a single annotated EMG burst for publication figures.",
          "script": "model_demo_single_peak.py",
          "script_path": "2025_Subcutaneous/EMG/model_demo_single_peak.py",
          "integration_status": "local_project_required",
          "params": [
            {
              "key": "csv_path",
              "label": "CSV file path",
              "type": "path",
              "desc": "From RHD Viewer export with time_s and value_uV columns."
            },
            {
              "key": "output_dir",
              "label": "Output folder",
              "type": "text",
              "default": "demo_figures"
            },
            {
              "key": "t_center",
              "label": "Peak time (ms)",
              "type": "number",
              "desc": "Approximate peak location.",
              "default": "0"
            },
            {
              "key": "window_ms",
              "label": "Display window (ms)",
              "type": "number",
              "default": "200"
            },
            {
              "key": "title",
              "label": "Figure title",
              "type": "text",
              "default": ""
            },
            {
              "key": "scale_bar",
              "label": "Scale bar (uV)",
              "type": "number",
              "default": "100"
            }
          ]
        },
        {
          "id": "emg_overlay",
          "name": "Overlay + Mean Envelope",
          "desc": "Overlay aligned EMG bursts with mean +/- SEM envelope.",
          "script": "model_overlay_mean.py",
          "script_path": "2025_Subcutaneous/EMG/model_overlay_mean.py",
          "integration_status": "local_project_required",
          "params": [
            {
              "key": "peaks_dir",
              "label": "Grouped peaks folder",
              "type": "path",
              "desc": "Folder with per-peak segment CSVs from EMG Peak Selector."
            },
            {
              "key": "output_dir",
              "label": "Output folder",
              "type": "text",
              "default": "overlay_figures"
            },
            {
              "key": "group",
              "label": "Group filter",
              "type": "text",
              "desc": "Leave blank for all groups.",
              "default": ""
            },
            {
              "key": "pre_ms",
              "label": "Pre-peak (ms)",
              "type": "number",
              "default": "50"
            },
            {
              "key": "post_ms",
              "label": "Post-peak (ms)",
              "type": "number",
              "default": "150"
            },
            {
              "key": "show_indiv",
              "label": "Show individual traces",
              "type": "checkbox",
              "default": true
            },
            {
              "key": "alpha",
              "label": "Individual trace alpha",
              "type": "number",
              "default": "0.15"
            }
          ]
        },
        {
          "id": "emg_bar",
          "name": "Group Bar Diagram",
          "desc": "Compare peak amplitudes across groups with statistical brackets.",
          "script": "model_bar_diagram.py",
          "script_path": "2025_Subcutaneous/EMG/model_bar_diagram.py",
          "integration_status": "local_project_required",
          "params": [
            {
              "key": "peaks_dir",
              "label": "Peaks summary folder",
              "type": "path"
            },
            {
              "key": "output_dir",
              "label": "Output folder",
              "type": "text",
              "default": "bar_diagrams"
            },
            {
              "key": "groups",
              "label": "Group order (comma-separated)",
              "type": "text",
              "default": "A,B,C"
            },
            {
              "key": "metric",
              "label": "Metric column",
              "type": "text",
              "default": "height"
            },
            {
              "key": "stat_test",
              "label": "Statistical test",
              "type": "select",
              "options": [
                "anova_tukey",
                "ttest"
              ],
              "default": "anova_tukey"
            }
          ]
        },
        {
          "id": "emg_heatmap",
          "name": "Amplitude Heatmap",
          "desc": "2D heatmap of peak amplitude across channels and conditions.",
          "script": "model_heatmap.py",
          "script_path": "2025_Subcutaneous/EMG/model_heatmap.py",
          "integration_status": "local_project_required",
          "params": [
            {
              "key": "peaks_dir",
              "label": "Peaks summary folder",
              "type": "path"
            },
            {
              "key": "output_dir",
              "label": "Output folder",
              "type": "text",
              "default": "heatmaps"
            },
            {
              "key": "row_var",
              "label": "Row variable",
              "type": "text",
              "default": "channel",
              "desc": "Column name for rows, for example channel."
            },
            {
              "key": "col_var",
              "label": "Column variable",
              "type": "text",
              "default": "condition",
              "desc": "Column name for columns, for example intensity."
            },
            {
              "key": "value_var",
              "label": "Value variable",
              "type": "text",
              "default": "height"
            },
            {
              "key": "colormap",
              "label": "Colormap",
              "type": "select",
              "options": [
                "Blues",
                "Reds",
                "viridis",
                "RdBu_r"
              ],
              "default": "Blues"
            }
          ]
        }
      ]
    },
    {
      "id": "echem_curves",
      "label": "Echem Curves",
      "description": "Dataset-specific electrochemistry curve figure scripts.",
      "documentation": "docs/pipelines/echem_curve_pipeline_README.md",
      "scripts": [
        {
          "id": "echem_pc_curve",
          "name": "Photocurrent Curve",
          "desc": "Plot mean absolute current change vs. light energy from pairs_summary.csv. This is a dataset-specific local project pipeline.",
          "script": "model_photocurrent_curve.py",
          "script_path": "2025_Subcutaneous/Electrochemistry/model_photocurrent_curve.py",
          "integration_status": "local_project_required",
          "params": []
        },
        {
          "id": "echem_pv_curve",
          "name": "Photovoltage Curve",
          "desc": "Plot mean absolute voltage change vs. light energy from pulses_summary.csv. This is a dataset-specific local project pipeline.",
          "script": "model_photovoltage_curve.py",
          "script_path": "2025_Subcutaneous/Electrochemistry/model_photovoltage_curve.py",
          "integration_status": "local_project_required",
          "params": []
        }
      ]
    },
    {
      "id": "viability",
      "label": "Cell Viability",
      "description": "Dataset-specific live/dead cell viability figure scripts.",
      "documentation": "docs/pipelines/viability_pipeline_README.md",
      "scripts": [
        {
          "id": "viab_watershed_area",
          "name": "Watershed Area Ratio",
          "desc": "Cell viability from watershed-based area quantification. This is a dataset-specific local project pipeline.",
          "script": "model_watershed_area_ratio.py",
          "script_path": "2025_Subcutaneous/Cell_Number_Counting/model_watershed_area_ratio.py",
          "integration_status": "local_project_required",
          "params": []
        },
        {
          "id": "viab_stardist_auto",
          "name": "StarDist Auto Detection Ratio",
          "desc": "Cell viability from StarDist auto-recognition results. This is a dataset-specific local project pipeline.",
          "script": "model_stardist_auto_ratio.py",
          "script_path": "2025_Subcutaneous/Cell_Number_Counting/model_stardist_auto_ratio.py",
          "integration_status": "local_project_required",
          "params": []
        }
      ]
    }
  ]
}
